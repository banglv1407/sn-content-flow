# Server Port & Host
HOST=0.0.0.0
PORT=8082
SECRET_KEY=change-me-to-a-secure-random-secret

# Google Drive API
# Path to service account json or OAuth token
GOOGLE_APPLICATION_CREDENTIALS=credentials.json
GOOGLE_DRIVE_FOLDER_ID=your_google_drive_folder_id

# Meta (Facebook Page & Instagram Business)
FACEBOOK_PAGE_ID=your_facebook_page_id
FACEBOOK_PAGE_ACCESS_TOKEN=your_facebook_page_long_lived_token
INSTAGRAM_ACCOUNT_ID=your_instagram_business_account_id

# TikTok API
TIKTOK_ACCESS_TOKEN=your_tiktok_access_token
TIKTOK_OPEN_ID=your_tiktok_open_id

# Schedule defaults (Crontab format or interval in hours)
DEFAULT_POST_INTERVAL_HOURS=6
