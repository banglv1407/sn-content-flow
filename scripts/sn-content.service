[Unit]
Description=SN Content Flow — Auto Social Publisher
After=network.target

[Service]
Type=simple
User=bang
WorkingDirectory=/home/bang/project/sn-content-flow
ExecStart=/home/bang/project/sn-content-flow/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8082
Restart=always
RestartSec=5
EnvironmentFile=-/home/bang/project/sn-content-flow/.env

[Install]
WantedBy=multi-user.target
